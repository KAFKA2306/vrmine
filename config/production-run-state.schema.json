{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-run-state.schema.json",
  "title": "VRMine Production Run State",
  "type": "object",
  "required": ["schema_version", "run_id", "request", "plan", "artifacts", "stages", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-zA-Z0-9._-]+$"},
    "request": {"type": "object"},
    "plan": {"type": "object"},
    "artifacts": {
      "type": "object",
      "required": ["raw", "normalized", "optimized", "reports", "renders", "unity", "evidence"],
      "properties": {
        "raw": {"type": "array", "items": {"type": "string"}},
        "normalized": {"type": "array", "items": {"type": "string"}},
        "optimized": {"type": "array", "items": {"type": "string"}},
        "reports": {"type": "array", "items": {"type": "string"}},
        "renders": {"type": "array", "items": {"type": "string"}},
        "unity": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "stage", "status", "attempts", "expected_outputs"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "stage": {"type": "string"},
          "status": {"enum": ["UNVERIFIED", "PASS", "REPAIRABLE", "BLOCKED"]},
          "attempts": {"type": "integer", "minimum": 0},
          "expected_outputs": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence": {"enum": ["UNVERIFIED", "PASS", "REPAIRABLE", "BLOCKED"]}
  },
  "additionalProperties": false
}
