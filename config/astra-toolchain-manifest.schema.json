{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/astra-toolchain-manifest.schema.json",
  "title": "VRMine Astra Toolchain Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "kind", "source", "generation", "provenance", "policy", "tools", "runtime"],
  "properties": {
    "$schema": { "const": "config/astra-toolchain-manifest.schema.json" },
    "schema_version": { "const": 2 },
    "kind": { "const": "astra_toolchain_manifest" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_spec", "canonical_spec_sha256", "repository_commit"],
      "properties": {
        "canonical_spec": { "type": "string", "pattern": "^config/world-items/.+\\.json$" },
        "canonical_spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "repository_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_seed"],
      "properties": {
        "deterministic_seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_with", "generation_method", "human_reviewed", "source_asset_license", "source_asset_license_status", "source_asset_provenance", "source_asset_urls"],
      "properties": {
        "generated_with": { "const": "gpt-6-astra" },
        "generation_method": { "const": "procedural" },
        "human_reviewed": { "type": "boolean" },
        "source_asset_license": { "type": "string", "minLength": 1 },
        "source_asset_license_status": { "type": "string", "minLength": 1 },
        "source_asset_provenance": { "type": "string", "minLength": 1 },
        "source_asset_urls": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "control_priority", "one_responsibility_one_authority", "experimental"],
      "properties": {
        "tier": { "enum": ["P0", "P1", "P2", "P3"] },
        "control_priority": { "const": ["code_cli", "blender_bpy_geometry_nodes", "mcp", "unity_batchmode", "cua"] },
        "one_responsibility_one_authority": { "const": true },
        "experimental": { "type": "boolean" }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "role", "control_mode", "tier", "source", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "control_mode": { "enum": ["code", "mcp", "cua", "manual"] },
          "tier": { "enum": ["P0", "P1", "P2", "P3"] },
          "source": { "type": ["string", "null"] },
          "license": { "type": ["string", "null"] },
          "exact_revision": { "type": ["string", "null"] }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blender", "unity", "vrchat", "pc", "android"],
      "properties": {
        "blender": { "$ref": "#/$defs/stage" },
        "unity": { "$ref": "#/$defs/stage" },
        "vrchat": { "$ref": "#/$defs/stage" },
        "pc": { "$ref": "#/$defs/stage" },
        "android": { "$ref": "#/$defs/stage" }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "UNVERIFIED"] },
        "evidence": { "type": ["string", "null"] }
      }
    }
  }
}
