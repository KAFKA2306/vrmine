{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config/production-request.schema.json",
  "title": "VRMine Production Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "concept", "target", "constraints", "quality"],
  "properties": {
    "$schema": {"const": "config/production-request.schema.json"},
    "kind": {"enum": ["world_prop", "world_layout", "rigged_asset", "avatar", "vrchat_gimmick"]},
    "concept": {"type": "string", "minLength": 1},
    "dimensions_m": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "engine"],
      "properties": {
        "platform": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["pc", "android"]}
        },
        "engine": {"const": "vrchat"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "movable": {"type": "boolean"},
        "collision": {"type": "boolean"},
        "max_materials": {"type": "integer", "minimum": 1},
        "max_triangles": {"type": "integer", "minimum": 1}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "topology"],
      "properties": {
        "visual": {"enum": ["draft", "production", "booth_ready"]},
        "topology": {"enum": ["generated", "editable", "riggable"]}
      }
    }
  }
}
