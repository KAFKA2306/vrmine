  "tactile_toys": [
    {
      "id": "wet_linen_curtain",
      "label": "濡れ麻ののれん幕",
      "count": 3,
      "affordance": "pinch_pull_release_weighted_hem",
      "sdk39_mechanism": "VRC_Pickup + VRC_ObjectSync (ForceKinematicOnRemote) + GPU vertex shader VRMine/QuestFabricWind",
      "sync_mode": "object_sync_handle_only",
      "max_anchor_deviation_m": 0.9,
      "return_to_rest_sec": 1.5,
      "haptics": { "duration_sec": 0.06, "amplitude": 0.25, "frequency_hz": 45 },
      "duo_resonance": "pulling two curtains together connects light ribbon and drops chimes into basin"
    },
    {
      "id": "rain_bead_strings",
      "label": "軒雫の鎖樋ストリング",
      "count": 4,
      "affordance": "hand_sweep_or_interact_rain_beads",
      "sdk39_mechanism": "VRCPlayerApi.GetTrackingData(LeftHand/RightHand) velocity + Desktop Interact + NetworkCallable(Others)",
      "sync_mode": "manual_event_only",
      "sync_bytes": 0,
      "scale_notes": ["D", "E", "F#", "A", "B"],
      "haptics": { "duration_sec": 0.025, "amplitude": 0.55, "frequency_hz": 180 },
      "duo_resonance": "second player pluck within 1.5s snaps to fifth/octave harmony and triggers interference ripples"
    },
    {
      "id": "water_glass_louvers",
      "label": "水紋ガラスの光パネル",
      "count": 2,
      "affordance": "tilt_and_filter_light_caustics",
      "sdk39_mechanism": "16-step discrete tilt + single-pass additive VRMine/QuestCausticsDecal (0 realtime lights)",
      "sync_mode": "manual",
      "sync_bytes": 3,
      "haptics": { "duration_sec": 0.03, "amplitude": 0.35, "frequency_hz": 110 },
      "duo_resonance": "overlapping both caustics over basin center shifts ambiance to after-rain halo"
    },
    {
      "id": "suikinkutsu_water_basin",
      "label": "水琴窟の波紋水盤",
      "count": 1,
      "stone_count": 3,
      "affordance": "touch_water_or_drop_pebbles",
      "sdk39_mechanism": "4-point analytic ripple shader VRMine/QuestWaterRipple (no GrabPass/DepthTexture) + VRC_Pickup pebbles",
      "sync_mode": "manual_director",
      "sync_bytes": 12,
      "resonance_window_sec": 3.0,
      "resonance_duration_sec": 8.0,
      "haptics": { "duration_sec": 0.12, "amplitude": 0.45, "frequency_hz": 75 },
      "duo_resonance": "2+ systems or 2+ players active within 3s triggers 8s synchronized courtyard resonance"
    }
  ],
