{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorldDesignSpec",
  "version": "1.1.0",
  "type": "object",
  "required": ["meta", "spatial_geometry", "social_clusters", "retreat_protocol", "optical_lighting", "media_governance", "runtime_budget", "provenance"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["spec_version", "theme_name", "primary_intents", "capacity_target", "platform_target"],
      "properties": {
        "spec_version": {"type": "string"},
        "theme_name": {"type": "string"},
        "primary_intents": {"type": "array", "minItems": 1, "items": {"enum": ["home", "social", "sleep", "cafe", "hotel", "exhibition", "photo", "video", "music", "game", "other"]}},
        "capacity_target": {"type": "integer", "minimum": 1, "maximum": 40},
        "platform_target": {"enum": ["PC_ONLY", "CROSS_PLATFORM_QUEST"]}
      }
    },
    "spatial_geometry": {
      "type": "object",
      "required": ["overall_width_m", "overall_depth_m", "corridor_clearance_m", "door_height_m", "door_width_m", "furniture_scale_factor", "zones"],
      "properties": {
        "overall_width_m": {"type": "number"},
        "overall_depth_m": {"type": "number"},
        "corridor_clearance_m": {"type": "number", "minimum": 1},
        "door_height_m": {"type": "number", "minimum": 1.5},
        "door_width_m": {"type": "number", "minimum": 0.7},
        "furniture_scale_factor": {"type": "number"},
        "zones": {"type": "array", "items": {"type": "object"}}
      }
    },
    "social_clusters": {"type": "object"},
    "retreat_protocol": {"type": "object"},
    "optical_lighting": {"type": "object"},
    "media_governance": {"type": "object"},
    "runtime_budget": {"type": "object"},
    "world_build": {
      "type": "object",
      "required": ["ceiling_height_m", "spawn", "social_core", "retreat", "activity_anchor", "hero_view", "circulation"],
      "properties": {
        "ceiling_height_m": {"type": "number", "exclusiveMinimum": 0},
        "spawn": {"type": "object", "required": ["position_m", "facing_deg", "buffer_radius_m"]},
        "social_core": {"type": "object", "required": ["center_m", "seat_count", "seat_radius_m", "table_asset_id", "seat_asset_id"]},
        "retreat": {"type": "object", "required": ["zone_id", "center_m", "seat_count", "seat_asset_id"]},
        "activity_anchor": {"type": "object", "required": ["kind", "position_m", "approach_clearance_m"]},
        "hero_view": {"type": "object", "required": ["position_m", "target_m"]},
        "circulation": {"type": "object", "required": ["waypoints_m", "minimum_clearance_m"]}
      }
    },
    "provenance": {"type": "object"}
  }
}
